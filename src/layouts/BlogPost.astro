---
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogNav from "@/components/blog-nav.astro";
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import { slugify, formatDate } from '@/lib/utils';

type Props = CollectionEntry<'blog'>['data'] & {
  readingTime: number;
  prevPost?: { slug: string; title: string } | null;
  nextPost?: { slug: string; title: string } | null;
  headings?: MarkdownHeading[];
  relatedPosts?: { slug: string; title: string; date: Date; sharedTags: string[] }[];
};

const { title, description, tags, publishDate, updatedDate, coverImage, readingTime, prevPost, nextPost, headings, relatedPosts } = Astro.props;

const toc = (headings || []).filter(h => h.depth >= 2 && h.depth <= 3);
---

<BlogLayout title={`${title} - Blog`} description={description} image={coverImage} pageType="article">
  <BlogNav currentPath={Astro.url.pathname} />
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description: description,
    datePublished: publishDate.toISOString(),
    ...(updatedDate ? { dateModified: updatedDate.toISOString() } : {}),
    author: { '@type': 'Person', name: 'Riasat Mahbub' },
    ...(coverImage ? { image: coverImage } : {}),
  })} />
  <main class="min-h-screen bg-[var(--background)] text-[var(--white)] pt-20">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="mb-8">
        <h1 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-4">{title}</h1>
        <p class="text-lg text-[var(--white-icon)] mb-4">{description}</p>
        
        <div class="flex flex-wrap gap-2 mb-4">
          {tags.map(tag => (
            <a href={`/blog/tags/${slugify(tag)}`} class="px-3 py-1 bg-[var(--white-icon-tr)] text-[var(--white-icon)] rounded-full text-sm hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)]/50 transition-colors">
              {tag}
            </a>
          ))}
        </div>
        
        <div class="flex items-center gap-3 text-sm text-[var(--white-icon)]">
          <span>{formatDate(publishDate)}</span>
          {updatedDate && (
            <>
              <span class="w-1 h-1 rounded-full bg-[var(--white-icon-tr)]"></span>
              <span>Updated {formatDate(updatedDate)}</span>
            </>
          )}
          <span class="w-1 h-1 rounded-full bg-[var(--white-icon-tr)]"></span>
          <span>{readingTime} min read</span>
          <span class="w-1 h-1 rounded-full bg-[var(--white-icon-tr)]"></span>
          <button
            id="copy-link-btn"
            class="text-[var(--white-icon)] hover:text-purple-400 transition-colors text-sm"
            title="Copy link"
            aria-label="Copy link to this post"
            aria-pressed="false"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4" aria-hidden="true">
              <path d="M6.9998 6V3C6.9998 2.44772 7.44752 2 7.9998 2H20.9998C21.5521 2 21.9998 2.44772 21.9998 3V17C21.9998 17.5523 21.5521 18 20.9998 18H17.9998V20.9991C17.9998 21.5519 17.549 21.9993 16.993 21.9993L3.00666 22C2.45059 21.9998 2 21.5516 2 20.9991L2.0026 7.00087C2.0027 6.44811 2.45264 6 3.01042 6H6.9998ZM8.9998 6H16.9998V16H19.9998V4H8.9998V6Z"/>
            </svg>
          </button>
          <span class="sr-only" id="copy-status" role="status" aria-live="polite"></span>
        </div>
      </div>
      
      {toc.length > 1 && (
        <nav class="mb-8 p-4 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c]" aria-label="Table of Contents">
          <h2 class="text-sm font-semibold text-[var(--white)] mb-3 uppercase tracking-wider">On this page</h2>
          <ul class="space-y-1.5">
            {toc.map(heading => (
              <li class={`${heading.depth === 3 ? 'ml-4' : ''}`}>
                <a
                  href={`#${heading.slug}`}
                  class="text-sm text-[var(--white-icon)] hover:text-purple-400 transition-colors"
                >
                  {heading.text}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}

      <div class="prose prose-lg max-w-none">
        <slot />
      </div>
      
      <!-- Previous / Next post navigation -->
      <div class="mt-12 pt-8 border-t border-[var(--white-icon-tr)] grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          {prevPost && (
            <a href={`/blog/${prevPost.slug}`} class="group flex items-center gap-2 text-[var(--white-icon)] hover:text-purple-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true">
                <path d="M10.8284 12.0007L15.7782 16.9504L14.364 18.3646L8 12.0007L14.364 5.63672L15.7782 7.05093L10.8284 12.0007Z" />
              </svg>
              <div class="text-left">
                <p class="text-xs text-[var(--white-icon)]/60">Previous</p>
                <p class="text-sm group-hover:text-purple-300 transition-colors line-clamp-1">{prevPost.title}</p>
              </div>
            </a>
          )}
        </div>
        <div class="md:text-right">
          {nextPost && (
            <a href={`/blog/${nextPost.slug}`} class="group flex items-center gap-2 md:flex-row-reverse text-[var(--white-icon)] hover:text-purple-400 transition-colors">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 shrink-0" aria-hidden="true">
                <path d="M13.1717 12.0007L8.22192 7.05093L9.63614 5.63672L16.0001 12.0007L9.63614 18.3646L8.22192 16.9504L13.1717 12.0007Z" />
              </svg>
              <div class="text-right">
                <p class="text-xs text-[var(--white-icon)]/60">Next</p>
                <p class="text-sm group-hover:text-purple-300 transition-colors line-clamp-1">{nextPost.title}</p>
              </div>
            </a>
          )}
        </div>
      </div>

      {relatedPosts && relatedPosts.length > 0 && (
        <div class="mt-12 pt-8 border-t border-[var(--white-icon-tr)]">
          <h2 class="text-lg font-semibold text-[var(--white)] mb-4">Related Posts</h2>
          <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-4">
            {relatedPosts.map(rp => (
              <a
                href={`/blog/${rp.slug}`}
                class="block p-4 rounded-xl border border-[var(--white-icon-tr)] bg-[#1414149c] hover:bg-[var(--white-icon-tr)] transition-all duration-300 group"
              >
                <p class="text-sm font-medium text-[var(--white)] group-hover:text-purple-400 transition-colors line-clamp-2 mb-1">
                  {rp.title}
                </p>
                <p class="text-xs text-[var(--white-icon)]">
                  {rp.sharedTags.length} shared tag{rp.sharedTags.length !== 1 ? 's' : ''}
                </p>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-6 text-center">
        <a href="/blog" class="text-purple-400 hover:text-purple-300 hover:underline transition-colors text-sm">
          ← Back to Blog
        </a>
      </div>
    </div>
  </main>
</BlogLayout>

<script>
  document.getElementById('copy-link-btn')?.addEventListener('click', () => {
    navigator.clipboard.writeText(window.location.href).then(() => {
      const btn = document.getElementById('copy-link-btn');
      const status = document.getElementById('copy-status');
      if (btn) {
        btn.classList.add('text-green-400');
        btn.setAttribute('aria-pressed', 'true');
        setTimeout(() => {
          btn.classList.remove('text-green-400');
          btn.setAttribute('aria-pressed', 'false');
        }, 1500);
      }
      if (status) {
        status.textContent = 'Link copied';
        setTimeout(() => { status.textContent = ''; }, 1500);
      }
    });
  });
</script>

<style is:global>
  .prose {
    color: var(--white-icon);
    line-height: 1.7;
  }
  
  .prose h2 {
    color: var(--white);
    font-size: 1.875rem;
    font-weight: 600;
    margin-top: 2rem;
    margin-bottom: 1rem;
  }
  
  .prose h3 {
    color: var(--white);
    font-size: 1.5rem;
    font-weight: 600;
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }
  
  .prose p {
    margin-bottom: 1rem;
    line-height: 1.7;
  }
  
  .prose ul, .prose ol {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }
  
  .prose li {
    margin-bottom: 0.5rem;
  }
  
  .prose code {
    background-color: var(--white-icon-tr);
    color: var(--white);
    padding: 0.25rem 0.5rem;
    border-radius: 0.25rem;
    font-size: 0.875rem;
    font-family: 'Courier New', Courier, monospace;
  }
  
  .prose pre {
    background-color: #1a1a1a;
    border-radius: 0.5rem;
    padding: 1rem;
    overflow-x: auto;
    margin: 1.5rem 0;
  }
  
  .prose pre code {
    background-color: transparent;
    padding: 0;
    color: #e5e7eb;
    font-size: 0.875rem;
  }
  
  .prose strong {
    color: var(--white);
    font-weight: 600;
  }
  
  .prose blockquote {
    border-left: 4px solid var(--white-icon-tr);
    padding-left: 1rem;
    margin: 1rem 0;
    font-style: italic;
  }
</style>
