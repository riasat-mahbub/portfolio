---
import ThemeToggle from "@/components/theme-toggle.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const defaultImage = "https://riasat-mahbub.github.io/riasat.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || "Blog - Riasat Mahbub"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/riasat.png" type="image/png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Blog - Riasat Mahbub"} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Riasat Mahbub Blog" />
    <meta property="og:url" content="https://riasat-mahbub.github.io/" />
    <meta property="og:image" content={image || defaultImage} />

    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Riasat Mahbub's Blog" href="/rss.xml" />
  </head>
  <body class="bg-[--background] transition-colors duration-300">
    <ThemeToggle />
    <slot />
    <footer class="border-t border-[var(--white-icon-tr)] mt-16 py-8 text-center text-sm text-[var(--white-icon)]">
      <div class="max-w-5xl mx-auto px-6">
        <p class="mb-2">&copy; {new Date().getFullYear()} Riasat Mahbub. All rights reserved.</p>
        <div class="flex justify-center gap-4">
          <a href="/" class="hover:text-[var(--white)] transition-colors">Home</a>
          <a href="/blog" class="hover:text-[var(--white)] transition-colors">Blog</a>
          <a href="/rss.xml" class="hover:text-[var(--white)] transition-colors" target="_blank" rel="noopener noreferrer">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
