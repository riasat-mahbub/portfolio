---
import ThemeToggle from "@/components/theme-toggle.astro";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { title, description, image } = Astro.props;
const defaultImage = "https://riasat-mahbub.github.io/riasat.png";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description || "Blog - Riasat Mahbub"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Blog - Riasat Mahbub"} />
    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="Riasat Mahbub Blog" />
    <meta property="og:url" content="https://riasat-mahbub.github.io/" />
    <meta property="og:image" content={image || defaultImage} />

    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Riasat Mahbub's Blog" href="/rss.xml" />
  </head>
  <body class="bg-[--background] transition-colors duration-300">
    <ThemeToggle />
    <slot />
    <footer class="border-t border-[var(--white-icon-tr)] mt-16 py-8 text-center text-sm text-[var(--white-icon)]">
      <div class="max-w-5xl mx-auto px-6">
        <p class="mb-2">&copy; {new Date().getFullYear()} Riasat Mahbub. All rights reserved.</p>
        <div class="flex justify-center gap-4">
          <a href="/" class="hover:text-[var(--white)] transition-colors">Home</a>
          <a href="/blog" class="hover:text-[var(--white)] transition-colors">Blog</a>
          <a href="/rss.xml" class="hover:text-[var(--white)] transition-colors" target="_blank" rel="noopener noreferrer">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import url('https://fonts.cdnfonts.com/css/montserrat');

  :root {
    --background: #101010;
    --sec: #a476ff;
    --white: #dfdfdf;
    --white-icon: #f3f3f398;
    --white-icon-tr: #f3f3f310;
  }

  [data-theme="light"] {
    --background: #ffffff;
    --sec: #6b46c1;
    --white: #111827;
    --white-icon: #6b7280;
    --white-icon-tr: #e5e7eb;
  }

  [data-theme="light"] .bg-\[\#1414149c\] {
    background-color: #f9fafb !important;
  }

  [data-theme="light"] .hover\:bg-\[var\(--white-icon-tr\)\]:hover {
    background-color: #e5e7eb !important;
  }

  [data-theme="light"] .border-\[\#ffffff10\] {
    border-color: #e5e7eb !important;
  }

  [data-theme="light"] .hover\:bg-\[\#1c1c1c\]:hover {
    background-color: #f3f4f6 !important;
  }

  * {
    font-family:
      "Montserrat",
      -apple-system,
      system-ui,
      sans-serif;
    box-sizing: border-box;
    padding: 0;
    margin: 0;
  }

  *::selection {
    background-color: var(--sec);
    color: var(--background);
  }

  ::-webkit-scrollbar {
    width: 15px;
  }

  ::-webkit-scrollbar-track {
    background: var(--container);
    border-radius: 30px;
  }

  ::-webkit-scrollbar-thumb {
    background: var(--background);
    border-radius: 10px;
  }

  ::-webkit-scrollbar-thumb:hover {
    background: var(--pink);
  }

  * {
    scrollbar-width: thin;
    scrollbar-color: var(--line) var(--container);
  }
</style>
