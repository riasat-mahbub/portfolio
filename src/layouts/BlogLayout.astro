---
import ThemeToggle from "@/components/theme-toggle.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
  image?: string;
  pageType?: 'website' | 'article';
  robots?: string;
  publishDate?: Date;
  tags?: string[];
}

const { title, description, image, pageType = 'article', robots = 'index, follow', publishDate, tags } = Astro.props;
const defaultImage = "https://riasat-mahbub.github.io/og.jpg";
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <script is:inline>
      (function() {
        const t = localStorage.getItem('theme') || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.setAttribute('data-theme', t);
      })();
    </script>
    <meta charset="UTF-8" />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.cdnfonts.com/css/montserrat?display=swap" />
    <meta name="description" content={description || "Blog - Riasat Mahbub"} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL.href} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description || "Blog - Riasat Mahbub"} />
    <meta property="og:type" content={pageType} />
    <meta property="og:site_name" content="Riasat Mahbub" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content={image || defaultImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="en_CA" />
    {
      pageType === 'article' && publishDate && (
        <meta property="og:article:published_time" content={publishDate.toISOString()} />
      )
    }
    {
      pageType === 'article' && tags && tags.map(tag => (
        <meta property="og:article:tag" content={tag} />
      ))
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description || "Blog - Riasat Mahbub"} />
    <meta name="twitter:image" content={image || defaultImage} />
    <meta name="theme-color" content="#101010" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="robots" content={robots} />

    <title>{title}</title>
    <link rel="alternate" type="application/rss+xml" title="Riasat Mahbub's Blog" href="/rss.xml" />
  </head>
  <body class="bg-[--background] transition-colors duration-300">
    <ThemeToggle />
    <slot />
    <footer class="border-t border-[var(--white-icon-tr)] mt-16 py-8 text-center text-sm text-[var(--white-icon)]">
      <div class="max-w-5xl mx-auto px-6">
        <p class="mb-2">&copy; {new Date().getFullYear()} Riasat Mahbub. All rights reserved.</p>
        <div class="flex justify-center gap-4">
          <a href="/" class="hover:text-[var(--white)] transition-colors">Home</a>
          <a href="/blog" class="hover:text-[var(--white)] transition-colors">Blog</a>
          <a href="/rss.xml" class="hover:text-[var(--white)] transition-colors" target="_blank" rel="noopener noreferrer">RSS</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
