---
import ThemeToggle from "@/components/theme-toggle.astro";
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <ClientRouter />
    <meta charset="UTF-8" />
    <meta name="description" content="Riasat Mahbub - Software Developer specializing in web development and artificial intelligence" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/riasat.png" type="image/png" />
    <meta property="og:title" content="Riasat Mahbub - Software Developer" />
    <meta property="og:description" content="Software Developer specializing in web development and artificial intelligence" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Riasat Mahbub Portfolio" />
    <meta property="og:url" content="https://riasat-mahbub.github.io/" />
    <meta property="og:image" content="https://riasat-mahbub.github.io/riasat.png" />

    <title>{title}</title>
  </head>
  <body class="bg-[--background] sm:px-28 lg:px-20 px-9 transition-colors duration-300">
    <ThemeToggle />
    <slot />
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>
