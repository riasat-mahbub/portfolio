---
import Layout from "@/layouts/Layout.astro";
---

<Layout title="Page Not Found — Riasat Mahbub" robots="noindex, follow">
  <main class="min-h-screen bg-[var(--background)] flex items-center justify-center">
    <div class="max-w-2xl mx-auto px-6 py-12 text-center">
      <div
        class="rounded-2xl shadow-lg bg-[#1414149c] border border-[var(--white-icon-tr)] p-8 sm:p-12"
      >
        <p class="text-7xl sm:text-8xl font-bold text-[var(--sec)] mb-4">404</p>
        <h1 class="text-2xl sm:text-3xl font-medium text-[var(--white)] mb-4">
          Page not found
        </h1>
        <p class="text-base text-[var(--white-icon)] mb-8">
          The page you're looking for doesn't exist or has been moved.
        </p>
        <div class="flex justify-center gap-4">
          <a
            href="/"
            class="px-5 py-2.5 rounded-xl bg-[var(--sec)] text-white text-sm font-medium hover:opacity-90 transition-opacity"
          >
            Home
          </a>
          <a
            href="/blog"
            class="px-5 py-2.5 rounded-xl border border-[var(--white-icon-tr)] text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] text-sm font-medium transition-all duration-300"
          >
            Blog
          </a>
        </div>
      </div>
    </div>
  </main>
</Layout>
