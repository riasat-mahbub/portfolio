---
import BlogLayout from "@/layouts/BlogLayout.astro";
import BlogNav from "@/components/blog-nav.astro";
import BlogCard from "@/components/blog-card.astro";
import { getPublishedPosts, sortByDateDesc, getAllTags } from '@/lib/blog';
import { slugify, readingTime } from '@/lib/utils';
import type { CollectionEntry } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const tags = getAllTags(posts);

  return Array.from(tags.entries()).map(([originalTag, _count]) => {
    const slug = slugify(originalTag);
    const filtered = posts.filter(post =>
      post.data.tags.some(t => slugify(t) === slug)
    );
    return {
      params: { tag: slug },
      props: { tag: originalTag, posts: filtered },
    };
  });
}

const { tag, posts } = Astro.props as {
  tag: string;
  posts: CollectionEntry<'blog'>[];
};

const sortedPosts = sortByDateDesc(posts);
---

<BlogLayout title={`Posts tagged "${tag}" - Blog`} description={`Blog posts tagged with "${tag}"`} pageType="website">
  <BlogNav currentPath={Astro.url.pathname} />
  <main class="min-h-screen bg-[var(--background)] text-[var(--white)] pt-20">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div class="mb-8">
        <a href="/blog/tags" class="text-sm text-purple-400 hover:text-purple-300 hover:underline transition-colors">
          ← All Tags
        </a>
      </div>
      <h1 class="text-3xl md:text-4xl font-medium text-[var(--white)] mb-2">
        Posts tagged: <span class="text-[var(--sec)]">"{tag}"</span>
      </h1>
      <p class="text-[var(--white-icon)] mb-12">{sortedPosts.length} post{sortedPosts.length !== 1 ? 's' : ''}</p>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {sortedPosts.map((post) => (
          <BlogCard post={post} readingTime={readingTime(post.body || '')} />
        ))}
      </div>
    </div>
  </main>
</BlogLayout>
