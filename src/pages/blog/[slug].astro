---
import BlogPost from '@/layouts/BlogPost.astro';
import { readingTime } from '@/lib/utils';
import { getPublishedPosts, sortByDateDesc, getRelatedPosts } from '@/lib/blog';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  const sorted = sortByDateDesc(posts);

  return sorted.map((post, index) => {
    const prevPost = index < sorted.length - 1 ? { slug: sorted[index + 1].slug, title: sorted[index + 1].data.title } : null;
    const nextPost = index > 0 ? { slug: sorted[index - 1].slug, title: sorted[index - 1].data.title } : null;
    const relatedPosts = getRelatedPosts(post, sorted);
    return {
      params: { slug: post.slug },
      props: { post, prevPost, nextPost, relatedPosts },
    };
  });
}

const { post, prevPost, nextPost, relatedPosts } = Astro.props;
const { Content, headings } = await post.render();

const rt = readingTime(post.body || '');
---

<BlogPost {...post.data} readingTime={rt} prevPost={prevPost} nextPost={nextPost} headings={headings} relatedPosts={relatedPosts}>
  <Content />
</BlogPost>
