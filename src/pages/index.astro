---
import Layout from "@/layouts/Layout.astro";
import Nav from "@/components/nav.astro";
import Home from "@/components/home.astro";
import Projects from "@/components/projects.astro";

import Experience  from "@/components/experience.astro"; 
import Education from "@/components/education.astro";
import BlogSection from "@/components/blog-section.astro";
import Connect from "@/components/connect.astro";
---

<Layout title="Riasat Mahbub">
  <script type="application/ld+json" is:inline set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Person',
    name: 'Riasat Mahbub',
    url: new URL('/', Astro.site).href,
    sameAs: [
      'https://github.com/riasat-mahbub',
      'https://www.linkedin.com/in/riasat-m-70682b115/',
    ],
    jobTitle: 'Software Developer',
  })} />
  <Nav />
  <Home />
  <Projects />
  <BlogSection />

  <Experience/>
  <Education />
  <Connect />
</Layout>
