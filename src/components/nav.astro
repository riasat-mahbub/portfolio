  { label: "Education", href: "#education", icon: `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-6 h-6"><path d="M11.7 2.805a.75.75 0 01.6 0A60.65 60.65 0 0122.83 8.72a.75.75 0 01-.231 1.337 49.949 49.949 0 00-9.903 3.03m0 0a.75.75 0 00.073.035.75.75 0 01.073-.035m5.183 8.318a.75.75 0 011.061 0 12.65 12.65 0 01-5.193 2.094.75.75 0 01-.513-1.42 11.125 11.125 0 005.13-1.84m-5.13 1.84a.75.75 0 01-.502 0l-.001-.001a75.65 75.65 0 00-2.92-1.157.75.75 0 01-.41-1.014 12.087 12.087 0 013.413-3.413.75.75 0 011.024.413 75.665 75.665 0 01-1.158 2.916.75.75 0 01-.485.567z"/></svg>` },
