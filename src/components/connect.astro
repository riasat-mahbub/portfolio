---
import { socialLinks } from '@/lib/social';
---

<section id="connect" class="w-full py-16 border-t border-[#ffffff10]">
  <div class="max-w-5xl mx-auto px-4">
    <!-- Header -->
    <div class="text-center mb-10">
      <h2 class="text-lg text-[var(--sec)] mb-2">Let's Connect</h2>
      <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)] mb-4">
        Stay in Touch
      </h3>
      <p class="text-[var(--white-icon)] max-w-2xl mx-auto">
        Have a question, collaboration idea, or just want to say hi?
        Reach out through any of the platforms below.
      </p>
    </div>

    <!-- Main Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-10">
      <!-- Contact Info -->
      <div class="flex flex-col items-center md:items-start space-y-4">
        <p class="text-[var(--white-icon)]">
          <strong>Location:</strong>
          <span class="text-[var(--white)]">Halifax, Canada</span>
        </p>
        <p class="text-[var(--white-icon)]">
          <strong>Email:</strong>
          <a
            href="mailto:riasat1998@gmail.com"
            class="text-[var(--white)] hover:text-[var(--sec)] transition"
          >
            riasat1998@gmail.com
          </a>
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex flex-col items-center justify-center">
        <div class="flex space-x-6 sm:space-x-8">
          {socialLinks.map(link => (
            <a
              href={link.href}
              target="_blank" rel="noopener noreferrer"
              class="flex flex-col items-center group"
              aria-label={link.label}
            >
              <div class="text-[var(--white-icon)] hover:text-[var(--white)] transition duration-300 ease-in-out">
                <div aria-hidden="true" set:html={link.svg} />
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Footer -->
    <div class="mt-16 pt-8 border-t-2 border-[#ffffff10] text-center">
      <p class="text-sm text-[var(--white-icon)]">
        &copy; {new Date().getFullYear()} <a href="https://github.com/riasat-mahbub" class="hover:text-[var(--sec)]">Riasat Mahbub</a>. All rights reserved.
      </p>
    </div>
  </div>
</section>
