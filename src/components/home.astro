---
import SocialLinks from "@/components/social-links.astro";
import { Image } from "astro:assets";
import riasat from "../../public/riasat.png";
---

<section class="max-w-5xl min-h-screen mx-auto space-y-8 md:py-36 pb-14 flex flex-col items-center justify-center" id="home">
  <div class="flex flex-col lg:flex-row items-center justify-center lg:items-start lg:space-x-12 my-auto ">
    
    <!-- Text Section -->
    <div class="flex-1 flex flex-col">
      <h1 class="text-5xl md:text-6xl font-semibold text-[var(--white)]">
        <span class="dark:text-red-700 text-red-500">Hi</span>, I'm Riasat
      </h1>
      <div class="flex flex-col lg:items-start mt-10 md:gap-4 space-y-4">
        <p class="text-md md:text-2xl text-[var(--white-icon)]">
            I build 
            <span class="dark:text-purple-400 text-purple-700 font-medium">human-centric</span> 
            software. My work blends clean design with solid engineering insights to deliver intuitive and responsive applications for everyday use.
        </p>

        <p class="text-md md:text-2xl text-[var(--white-icon)]">
            My projects span 
            <span class="dark:text-purple-400 text-purple-700 font-medium">research-driven </span>
            explorations of code quality to full-blown 
            <span class="dark:text-purple-400 text-purple-700 font-medium">web applications.</span> 
            You can explore them below to see what I've been working on.
        </p>
        
        <SocialLinks/>
        <a
          href="/Resume.pdf"
          target="_blank"
          rel="noopener noreferrer"
          class="mt-4 inline-flex items-center gap-2 px-5 py-2.5 rounded-full border border-[var(--white-icon-tr)] bg-[#1414149c] text-[var(--white-icon)] hover:text-[var(--white)] hover:bg-[var(--white-icon-tr)] transition duration-300 ease-in-out"
        >
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5" aria-hidden="true">
            <path d="M12 3a1 1 0 011 1v9.586l2.293-2.293a1 1 0 011.414 1.414l-4 4a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L11 13.586V4a1 1 0 011-1zm-7 14a1 1 0 011 1v1h12v-1a1 1 0 112 0v2a1 1 0 01-1 1H5a1 1 0 01-1-1v-2a1 1 0 011-1z"/>
          </svg>
          <span class="text-sm md:text-base font-medium">Download Resume</span>
        </a>
      </div>
    </div>

    <!-- Image Section -->
    <div class="hidden md:flex lg:flex-shrink-0 justify-center mb-6 lg:mb-0">
      <Image
        src={riasat}
        alt="Riasat Mahbub"
        width={272}
        height={272}
        class="rounded-full border-4 border-[var(--white)] object-cover"
      />
    </div>

  </div>

</section>

