---
import { Image } from "astro:assets";
import bs23 from "../../public/bs23-logo.jpg"
import dal from "../../public/dal-light.png"

interface Experience {
  role: string;
  image: ImageMetadata;
  institution: string;
  year: string;
  description: string[];
}


const experiences: Experience[] = [
  {
    role: "Research Assistant",
    image: dal,
    institution: "Dalhousie University",
    year: "2023-2025",
    description: [
      "Conducted research at the intersection of Software Engineering  and Simulation systems, addressing often overlooked code quality concerns in simulation software.",
      "Researched large scale empirical studies comparing 155 simulation and 327 traditional projects for code quality (SCAM 2024) and refactoring practices (TRBAM 2026).",
      "Furthered development of in-house simulation software by addressing code quality concerns and contributing to implementing critical features.",
    ],
  },
  {
    role: "Associate Software Engineer",
    image: bs23,
    institution: "Brain Station 23",
    year: "2022-2023",
    description: [
      "Engineered full-stack web and mobile applications using Angular, Laravel, and Ionic across high-rotation client projects.",
      "Provisioned Linux environments and deployed containerized applications using Docker, Git version control, and CI/CD pipelines.",
      "Developed custom Moodle and WordPress plugins, including an Ionic mobile interface designed to parse and structure Moodle HTML outputs.",
      "Maintained application reliability and reduced technical debt by authoring unit and integration test suites across legacy and new codebases."
    ],
  },
];
---

<section class="text-[var(--white)] py-16 border-t-2 border-[#ffffff10]" id="experience">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="text-center space-y-4">
      <h2 class="text-lg text-[var(--sec)] mb-2">My career</h2>
      <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)]">
        Work Experience
      </h3>
    </div>

    <div class="grid gap-8 md:gap-12">
      {experiences.map((item) => (
        <div class="border border-[var(--white-icon-tr)] rounded-xl p-4 md:p-6 bg-[#1414149c] hover:bg-[var(--white-icon-tr)] transition duration-300 flex flex-col md:flex-row md:items-start gap-4 md:gap-6">
          <div class="w-16 h-16 md:w-28 md:h-28 shrink-0 rounded-lg flex items-center justify-center bg-white">
            <Image src={item.image} alt={item.institution} class="w-12 h-12 md:w-20 md:h-20" />
          </div>
          <div class="flex flex-col flex-1 text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2">
              <h3 class="text-xl md:text-2xl font-medium text-[var(--white)]">
                {item.role}
              </h3>
              <span class="text-[var(--white-icon)] text-xs md:text-sm mt-1 md:mt-0 px-2 py-0.5 rounded-full border border-[var(--white-icon-tr)] self-center md:self-auto">
                {item.year}
              </span>
            </div>
            <h4 class="text-sm md:text-base text-[var(--white-icon)] mb-3">
              {item.institution}
            </h4>
            <ul class="text-[var(--white-icon)] text-sm md:text-[0.95rem] space-y-1.5 list-disc pl-5 marker:text-[var(--sec)]">
              {item.description.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>