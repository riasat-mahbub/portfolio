---
import { Image } from "astro:assets";
import bracu from "../../public/bracu_alt.png";
import dal from "../../public/dal-light.png"

interface Education {
  degree: string;
  image: ImageMetadata;
  institution: string;
  year: string;
  description: string[];
}


const educations: Education[] = [
{
    degree: "Master of Computer Science",
    image: dal,
    institution: "Dalhousie University",
    year: "2025",
    description: [
      "Collaborated across disciplines with civil engineers to integrate empirical software engineering practices into domain-specific simulation systems.",
      "Researched local LLM agent workflows, refactoring patterns, and static analysis metrics across 482 open-source repositories.",
      "Authored a Master's thesis evaluating the impact of code smells on simulation modeling software maintainability."
    ],
  },
  {
    degree: "Bachelor of Computer Science and Engineering",
    image: bracu,
    institution: "BRAC University",
    year: "2021",
    description: [
      "Established core foundation in algorithms, data structures, relational database design, and software architecture.",
      "Sharpened algorithmic thinking and analytical problem-solving skills through competitive programming contests and coursework.",
      "Engineered machine learning and recommendation system capstone projects using Python and statistical data pipelines."
    ],
  }

];
---

<section class="text-[var(--white)] py-16 border-[#ffffff10] border-t-2" id="education">
  <div class="max-w-5xl mx-auto space-y-8">
    <div class="text-center space-y-4">
      <h2 class="text-lg text-[var(--sec)] mb-2">My background</h2>
      <h3 class="text-4xl md:text-5xl font-medium text-[var(--white)]">
        Education
      </h3>
    </div>

    <div class="grid gap-8 md:gap-12">
      {educations.map((item) => (
        <div class="rounded-xl p-4 md:p-6 flex flex-col md:flex-row md:items-start gap-4 md:gap-6 border border-[var(--white-icon-tr)]  bg-[#14141450] hover:bg-[#1414149c] transition duration-300">
          <div class={`w-16 h-16 md:w-28 md:h-28 shrink-0 mb-4 md:mb-0 rounded-lg flex items-center justify-center bg-white`}>
            <Image src={item.image} alt={item.institution} class="w-12 h-12 md:w-20 md:h-20" />
          </div>
          <div class="flex flex-col flex-1 text-center md:text-left">
            <div class="flex flex-col md:flex-row md:items-center md:justify-between mb-2">
              <h3 class="text-xl md:text-2xl font-medium text-[var(--white)]">
                {item.degree}
              </h3>
              <span class="text-[var(--white-icon)] text-xs md:text-sm mt-1 md:mt-0 px-2 py-0.5 rounded-full border border-[var(--white-icon-tr)] self-center md:self-auto">
                {item.year}
              </span>
            </div>
            <h4 class="text-sm md:text-base text-[var(--white-icon)] mb-3">
              {item.institution}
            </h4>
            <ul class="text-[var(--white-icon)] text-sm md:text-[0.95rem] space-y-1.5 list-disc pl-5 marker:text-[var(--sec)]">
              {item.description.map((line) => (
                <li>{line}</li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>