---
interface Project {
  title: string;
  link: string;
  description: string;
  tags?: string[];
}

const projects: Project[] = [
  {
    title: "MBuddy",
    link: "https://github.com/riasat-mahbub/MBuddy",
    description: "Local manga and anime recommendation engine driven by freeform queries utilizing a hybrid embeddings, metadata and textual search model. Recommendations come from a data pipeline of 189,000 entries.",
    tags: ["Python", "Embeddings", "Search", "Recommender"],
  },
  {
    title: "Aergia",
    link: "https://github.com/riasat-mahbub/aergia-new",
    description: "Free and professional resume builder built with a focus on clean UX and print-ready output.",
    tags: ["React", "Node.js", "PDF Generation", "Resume Builder"],
  },
  {
    title: "Wozaro",
    link: "https://github.com/riasat-mahbub/wozaro",
    description: "A hub for casual games — designed for quick play sessions with a clean, responsive interface.",
    tags: ["React", "Node.js", "Games", "Casual"],
  },
  {
    title: "project-tracker-skill",
    link: "https://github.com/riasat-mahbub/project-tracker-skill",
    description: "A reusable skill for AI coding agents (Reasonix, OpenCode, Claude Code) that maintains a file-based project knowledge graph — tracking bugs, features, ADRs, and tasks as markdown files with YAML frontmatter.",
    tags: ["Skill", "Markdown", "YAML", "Knowledge Graph"],
  },
  {
    title: "project-tracker-graph",
    link: "https://github.com/riasat-mahbub/project-tracker-graph",
    description: "A Python CLI library for building and querying file-based project knowledge graphs. Generates dashboards, JSON adjacency maps, and automatic backlinks so agents can navigate project structure without parsing every file.",
    tags: ["Python", "CLI", "Knowledge Graph", "YAML"],
  },
  {
    title: "footer-branding",
    link: "https://github.com/riasat-mahbub/footer-branding",
    description: "A template-driven, customizable footer component for little-coder terminals featuring a honey-colored watermark, color-coded context usage, token counts, cost tracking, and model info.",
    tags: ["TypeScript", "Templates", "CLI", "Terminal"],
  },
];

const research: Project[] = [
  {
    title: "Understanding Code Smells and Refactoring Practices in Simulation Modelling Systems - A Comprehensive Study",
    link: "https://dalspace.library.dal.ca/items/54690d16-478b-4d03-b2fd-12a95080d753",
    description: "Masters thesis on code smells and refactoring patterns in large-scale simulation modelling repositories.",
    tags: ["Code Smells", "Refactoring", "Simulation", "Thesis"],
  },
  {
    title: "On the Prevalence, Evolution, and Impact of Code Smells in Simulation Modelling Software",
    link: "https://www.arxiv.org/abs/2409.03957",
    description: "Empirical study analyzing code smells across simulation modelling projects using pandas, Designite, parquet, BM25, seaborn and other data analysis and visualization frameworks.",
    tags: ["Code Smells", "Empirical Study", "Pandas", "Designite"],
  },
  {
    title: "Exploring Code Smells In Simulation Modelling Systems: Effectiveness, Risks And Impacts",
    link: "https://www.nationalacademies.org/events/886",
    description: "Study on the effectiveness, risks and impacts of code smells in simulation modelling systems, published at the TRB Annual Meeting.",
    tags: ["Code Smells", "TRB 2026", "Risks", "Impacts"],
  },
  {
    title: "City Recommender System: A Comparative Study of AI-Driven Approaches",
    link: "https://link.springer.com/chapter/10.1007/978-3-031-73125-9_17",
    description: "Comparative study of classic machine learning methods and a neural network approach for a city recommender system.",
    tags: ["Machine Learning", "Neural Network", "Recommender", "Comparative Study"],
  },
  {
    title: "Neural Network Architecture for the Classification of Alzheimer's Disease from Brain MRI",
    link: "https://ieeexplore.ieee.org/document/9707412",
    description: "Alzheimer's detection system utilizing 3D MRI data with CNNs and ensemble modeling.",
    tags: ["Deep Learning", "CNN", "3D MRI", "Healthcare"],
  },
];
---

<section class="py-16 border-[#ffffff10] text-[var(--white)] border-t-2" id="projects">
  <article class="max-w-5xl mx-auto">
    <h2 class="text-lg text-[var(--sec)] mb-2">My work</h2>
    <h3 class="text-4xl md:text-5xl font-medium mb-8">Projects</h3>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
      {projects.map((project) => (
        <a
          href={project.link}
          target="_blank"
          rel="noopener noreferrer"
          class="group"
        >
          <div
            class="flex flex-col justify-between h-full rounded-2xl shadow-lg bg-[#1414149c]
                  p-5 sm:p-6 transition-all duration-300 
                  hover:shadow-xl hover:scale-[1.03] hover:bg-[#1c1c1c]"
          >
            <div>
              <h4 class="text-xl sm:text-2xl font-semibold mb-2 leading-snug">
                {project.title}
              </h4>
              <p class="text-sm sm:text-base text-[var(--white-icon)] leading-relaxed mb-3">
                {project.description}
              </p>
              {project.tags && project.tags.length > 0 && (
                <div class="flex flex-wrap gap-2 mt-2">
                  {project.tags.map(tag => (
                    <span class="px-2 py-1 bg-[var(--white-icon-tr)] text-[var(--white-icon)] rounded text-xs">
                      {tag}
                    </span>
                  ))}
                </div>
              )}
            </div>

            <div
              class="self-end mt-6 size-12 sm:size-14 flex justify-center items-center 
                    text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out 
                    border border-[var(--white-icon-tr)] p-3 rounded-xl 
                    bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                viewBox="0 0 24 24"
                fill="currentColor"
                class="size-6 sm:size-7"
                aria-hidden="true"
              >
                <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
              </svg>
            </div>
          </div>
        </a>
      ))}
    </div>
    <div class="w-full flex items-center justify-center mt-9">
      <a
        target="_blank"
        href="https://github.com/riasat-mahbub?tab=repositories"
        aria-label="GitHub"
        class="w-full max-w-5xl mx-auto flex items-center justify-center gap-2 text-[var(--white-icon)] dark:hover:text-white hover:text-black transition duration-300 ease-in-out border border-[var(--white-icon-tr)] p-3 rounded-full bg-[#1414149c] hover:bg-[var(--white-icon-tr)] hover:scale-105"
      >
        <span class="md:text-lg text-md">More projects on</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
          class="size-6"
        >
          <path
            d="M12.001 2C6.47598 2 2.00098 6.475 2.00098 12C2.00098 16.425 4.86348 20.1625 8.83848 21.4875C9.33848 21.575 9.52598 21.275 9.52598 21.0125C9.52598 20.775 9.51348 19.9875 9.51348 19.15C7.00098 19.6125 6.35098 18.5375 6.15098 17.975C6.03848 17.6875 5.55098 16.8 5.12598 16.5625C4.77598 16.375 4.27598 15.9125 5.11348 15.9C5.90098 15.8875 6.46348 16.625 6.65098 16.925C7.55098 18.4375 8.98848 18.0125 9.56348 17.75C9.65098 17.1 9.91348 16.6625 10.201 16.4125C7.97598 16.1625 5.65098 15.3 5.65098 11.475C5.65098 10.3875 6.03848 9.4875 6.67598 8.7875C6.57598 8.5375 6.22598 7.5125 6.77598 6.1375C6.77598 6.1375 7.61348 5.875 9.52598 7.1625C10.326 6.9375 11.176 6.825 12.026 6.825C12.876 6.825 13.726 6.9375 14.526 7.1625C16.4385 5.8625 17.276 6.1375 17.276 6.1375C17.826 7.5125 17.476 8.5375 17.376 8.7875C18.0135 9.4875 18.401 10.375 18.401 11.475C18.401 15.3125 16.0635 16.1625 13.8385 16.4125C14.201 16.725 14.5135 17.325 14.5135 18.2625C14.5135 19.6 14.501 20.675 14.501 21.0125C14.501 21.275 14.6885 21.5875 15.1885 21.4875C19.259 20.1133 21.9999 16.2963 22.001 12C22.001 6.475 17.526 2 12.001 2Z"
          ></path>
        </svg>
      </a>
    </div>
  </article>

  <article class="py-12 border-t border-[#ffffff10] text-[var(--white)] max-w-5xl mx-auto my-10 px-4 sm:px-6 lg:px-0">
    <div class="max-w-5xl mx-auto">
      <h3 class="text-4xl md:text-5xl font-medium mb-10 text-center md:text-left">
        Research
      </h3>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 md:gap-8">
        {research.map((paper) => (
          <a
            href={paper.link}
            target="_blank"
            rel="noopener noreferrer"
            class="group"
          >
            <div
              class="flex flex-col justify-between h-full rounded-2xl shadow-lg bg-[#1414149c]
                    p-5 sm:p-6 transition-all duration-300 
                    hover:shadow-xl hover:scale-[1.03] hover:bg-[#1c1c1c]"
            >
              <div>
                <h4 class="text-xl sm:text-2xl font-semibold mb-2 leading-snug">
                  {paper.title}
                </h4>
                {paper.description && (
                  <p class="text-sm sm:text-base text-[var(--white-icon)] leading-relaxed">
                    {paper.description}
                  </p>
                )}
                {paper.tags && paper.tags.length > 0 && (
                  <div class="flex flex-wrap gap-2 mt-2">
                    {paper.tags.map(tag => (
                      <span class="px-2 py-1 bg-[var(--white-icon-tr)] text-[var(--white-icon)] rounded text-xs">
                        {tag}
                      </span>
                    ))}
                  </div>
                )}
              </div>

              <div
                class="self-end mt-6 size-12 sm:size-14 flex justify-center items-center 
                      text-[var(--white-icon)] hover:text-white transition duration-300 ease-in-out 
                      border border-[var(--white-icon-tr)] p-3 rounded-xl 
                      bg-[#1414149c] hover:bg-[var(--white-icon-tr)]"
              >
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="size-6 sm:size-7"
                >
                  <path d="M16.0037 9.41421L7.39712 18.0208L5.98291 16.6066L14.5895 8H7.00373V6H18.0037V17H16.0037V9.41421Z" />
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </article>

</section>
